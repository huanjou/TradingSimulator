  "panels": [
    {
      "title": "API Gateway: Requests Per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count{exported_job=\"api-gateway\"}[1m])) by (http_method)",
          "legendFormat": "RPS ({{http_method}})",
          "refId": "A"
        }
      ]
    },
    {
      "title": "API Gateway: P95 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{exported_job=\"api-gateway\"}[1m])) by (le))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        }
      ]
    },
    {
      "title": "API Gateway: Errors (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count{exported_job=\"api-gateway\", http_status_code=~\"4..|5..\"}[1m])) by (http_status_code)",
          "legendFormat": "HTTP {{http_status_code}}",
          "refId": "A"
        }
      ]
    },
