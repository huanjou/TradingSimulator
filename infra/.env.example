# ==========================================================================
# ENVIRONMENT TEMPLATE
#
# Copy to `.env` and fill in REAL values before deploying.
#   cp .env.example .env
#
# Generate strong secrets (Linux/macOS):
#   openssl rand -hex 32
# On Windows PowerShell:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# NEVER commit the real `.env` (it is git-ignored).
# ==========================================================================

# ---- ИНФРАСТРУКТУРА / БАЗА ДАННЫХ ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=strong_db_password
POSTGRES_DB=ledger_db
POSTGRES_REPLICA_USER=repl_user
POSTGRES_REPLICA_PASSWORD=strong_replica_password

# ---- REDIS ----
# Required in production (docker-compose.prod.yml). Redis is started with --requirepass.
REDIS_PASSWORD=strong_redis_password

# ---- СЕРВИСЫ ----
# development | production
APP_ENV=development

# Public origin of the frontend (used for CORS + TLS). Example: https://app.example.com
PUBLIC_ORIGIN=https://domain.example.com

# ---- СЕКРЕТЫ ----
# 32+ bytes of randomness. Do NOT reuse the dev default in production.
JWT_SECRET=openssl_rand_hex_32

# ---- МОНИТОРИНГ ----
GRAFANA_ADMIN_PASSWORD=strong_grafana_password

# ---- НАЧАЛЬНЫЙ АДМИН (только dev; в prod суперюзер создаётся вручную) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strong_admin_password

# ---- Настройки логирования ----
SAMPLING_PERCENTAGE=100
